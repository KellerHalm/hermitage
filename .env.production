# === Docker Compose Environment ===
# Copy this file to .env and fill in values

# Server IP or domain (without protocol)
HOST_IP=YOUR_SERVER_IP

# Site URL (for sitemap, SEO — include protocol)
NEXT_PUBLIC_SITE_URL=http://YOUR_SERVER_IP

# PostgreSQL
POSTGRES_DB=hermitage_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_password

# Backend
JWT_SECRET=change_this_to_a_strong_random_string_at_least_32_chars

# SMTP (email notifications)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HERMITAGE DECOR <noreply@hermitage-decor.ru>"
